# ==============================================================================
# Crypto-Tracer Environment Configuration Template
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Application Metadata & Security
APP_NAME=Crypto-Tracer
# APP_ENV: development | test | production
# In production, secure SECRET_KEY (min 32 chars) and non-default DATABASE_URL are strictly enforced.
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=insecure-dev-secret-key-change-me-for-production-use-only-0000
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
LOG_FORMAT=text

# PostgreSQL Persistence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crypto_tracer
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crypto_tracer

# Redis Cache
REDIS_URL=redis://localhost:6379/0
BLOCKCHAIN_CACHE_TTL_SECONDS=3600

# TRON Blockchain Provider (TronGrid API & Mainnet Ingestion)
DEFAULT_EXECUTION_MODE=LIVE
TRON_API_BASE_URL=https://api.trongrid.io
TRON_FALLBACK_API_URLS=
TRON_API_KEY=
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_HTTP_TIMEOUT_SECONDS=10.0
TRON_MAX_RETRIES=3

# Frontend
VITE_API_URL=/api/v1
