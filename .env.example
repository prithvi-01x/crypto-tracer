# ==============================================================================
# Crypto-Tracer (SIH 2026 #SIH26182) - Environment Configuration
# ==============================================================================

# Application
APP_NAME=Crypto-Tracer
APP_ENV=development
LOG_LEVEL=INFO

# Backend API
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crypto_tracer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crypto_tracer
POSTGRES_PORT=5432

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6380

# Blockchain Ingestion (TRON / TronGrid)
TRON_API_BASE_URL=https://api.trongrid.io
TRON_API_KEY=

# Investigation Engine Defaults
MAX_HOPS=4
MAX_NODES=500
MAX_EDGES=2000
MIN_RELEVANT_USD=1.00
